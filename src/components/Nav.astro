---
/**
 * Nav — persistent primary navigation with a "shining" treatment.
 *
 * Renders plain anchor links (works with JS off). Active state is computed from
 * the normalized pathname so at most one link is active, and exactly one when
 * the path matches a top-level route. Case-study pages (`/work/{slug}`) leave
 * all top-level links inactive. The header persists across View Transitions, so
 * a tiny `astro:page-load` handler recomputes the active link after each swap.
 *
 * Shining treatment (v2): once scrolled past the top, the nav drops its solid
 * background and switches to `mix-blend-mode: difference` with light text, so
 * the logo and links invert against whatever section scrolls behind them. Near
 * the very top and at/below the mobile breakpoint it stays solid for legibility
 * (see media query). A section can force a solid nav by carrying
 * `data-nav="solid"`, handled by the scroll observer below.
 */

const links = [
  { href: '/', label: 'Home' },
  { href: '/work/businesses', label: 'Businesses' },
  { href: '/work/personalities', label: 'Personalities' },
  { href: '/founders', label: 'Founders' },
  { href: '/about', label: 'About' },
];

function normalize(path: string): string {
  if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
  return path;
}

const current = normalize(Astro.url.pathname);
---

<nav class="nav nav--solid" aria-label="Primary" data-nav>
  <a href="/" class="nav__brand">tszuk.</a>
  <ul class="nav__list">
    {
      links.map((link) => {
        const isActive = current === link.href;
        return (
          <li>
            <a
              href={link.href}
              class:list={['nav__link', { 'is-active': isActive }]}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  // Recompute active state after each client-side navigation (header persists).
  function updateActiveNav() {
    const path = (() => {
      const p = window.location.pathname;
      return p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p;
    })();

    document.querySelectorAll<HTMLAnchorElement>('.nav__link').forEach((a) => {
      const href = a.getAttribute('href') || '';
      const isActive = path === href;
      a.classList.toggle('is-active', isActive);
      if (isActive) {
        a.setAttribute('aria-current', 'page');
      } else {
        a.removeAttribute('aria-current');
      }
    });
  }

  // Shining toggle: solid near the top, shining (blend mode) once scrolled.
  // Bound once; the nav persists across view transitions.
  function initNavShine() {
    const nav = document.querySelector('.nav') as HTMLElement | null;
    if (!nav || nav.dataset.shineBound === 'true') return;
    nav.dataset.shineBound = 'true';

    const TOP_THRESHOLD = 80;
    function sync() {
      const y = window.scrollY;
      // Solid at the very top; shining once past the threshold.
      nav!.classList.toggle('nav--solid', y <= TOP_THRESHOLD);
    }
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  document.addEventListener('astro:page-load', () => {
    updateActiveNav();
    initNavShine();
  });
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    /* Default (shining) state: transparent, inverts against content behind it. */
    background-color: transparent;
    mix-blend-mode: difference;
    transition: background-color var(--duration-hover) var(--easing);
  }

  /* Shining state uses light ink so difference blending inverts it per section. */
  .nav:not(.nav--solid) .nav__brand,
  .nav:not(.nav--solid) .nav__link {
    color: #ffffff;
  }

  /* Solid state (near top of page, and always on mobile): legible, no blend. */
  .nav--solid {
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-divider);
    mix-blend-mode: normal;
  }

  .nav__brand {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--color-text);
    transition: color var(--duration-hover) var(--easing);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    position: relative;
    font-size: 0.9rem;
    color: var(--color-muted);
    padding: 0.25rem 0;
    transition: color var(--duration-hover) var(--easing);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-hover) var(--easing);
  }

  .nav--solid .nav__link:hover {
    color: var(--color-text);
  }

  .nav--solid .nav__link.is-active {
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  @media (min-width: 768px) {
    .nav {
      padding: 1rem 2.5rem;
    }

    .nav__list {
      gap: 2rem;
    }
  }

  /* Mobile: always solid, never blend (matches One Room behavior). */
  @media (max-width: 767px) {
    .nav,
    .nav:not(.nav--solid) {
      background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--color-divider);
      mix-blend-mode: normal;
    }

    .nav:not(.nav--solid) .nav__brand {
      color: var(--color-text);
    }

    .nav:not(.nav--solid) .nav__link {
      color: var(--color-muted);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav__brand,
    .nav__link,
    .nav__link::after {
      transition: none;
    }
  }
</style>
