---
/**
 * Nav — persistent primary navigation with a "shining" treatment.
 *
 * Renders plain anchor links (works with JS off). Active state is computed from
 * the normalized pathname so at most one link is active, and exactly one when
 * the path matches a top-level route. Case-study pages (`/work/{slug}`) leave
 * all top-level links inactive. The header persists across View Transitions, so
 * a tiny `astro:page-load` handler recomputes the active link after each swap.
 *
 * Shining treatment (v2): once scrolled past the top, the nav drops its solid
 * background and switches to `mix-blend-mode: difference` with light text, so
 * the logo and links invert against whatever section scrolls behind them. Near
 * the very top and at/below the mobile breakpoint it stays solid for legibility
 * (see media query). A section can force a solid nav by carrying
 * `data-nav="solid"`, handled by the scroll observer below.
 */

const links = [
  { href: '/', label: 'Home' },
  { href: '/work/businesses/', label: 'Businesses' },
  { href: '/work/personalities/', label: 'Personalities' },
  { href: '/founders/', label: 'Founders' },
  { href: '/about/', label: 'About' },
];

// Compare paths ignoring a trailing slash so the match is robust either way.
function normalize(path: string): string {
  if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
  return path;
}

const current = normalize(Astro.url.pathname);
---

<nav class="nav" aria-label="Primary" data-nav>
  <a href="/" class="nav__brand">tszuk.</a>
  <button
    type="button"
    class="nav__toggle"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="nav-menu"
    data-nav-toggle
  >
    <span class="nav__toggle-bar" aria-hidden="true"></span>
    <span class="nav__toggle-bar" aria-hidden="true"></span>
    <span class="nav__toggle-bar" aria-hidden="true"></span>
  </button>
  <ul class="nav__list" id="nav-menu">
    {
      links.map((link) => {
        const isActive = current === normalize(link.href);
        return (
          <li>
            <a
              href={link.href}
              class:list={['nav__link', { 'is-active': isActive }]}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  // Recompute active state after each client-side navigation (header persists).
  function updateActiveNav() {
    const path = (() => {
      const p = window.location.pathname;
      return p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p;
    })();

    const strip = (p: string) =>
      p.length > 1 && p.endsWith('/') ? p.slice(0, -1) : p;

    document.querySelectorAll<HTMLAnchorElement>('.nav__link').forEach((a) => {
      const href = strip(a.getAttribute('href') || '');
      const isActive = path === href;
      a.classList.toggle('is-active', isActive);
      if (isActive) {
        a.setAttribute('aria-current', 'page');
      } else {
        a.removeAttribute('aria-current');
      }
    });
  }

  // Nav background toggle: transparent at the top, solid once scrolled past the
  // threshold. Bound once; the nav persists across view transitions.
  function initNavShine() {
    const nav = document.querySelector('.nav') as HTMLElement | null;
    if (!nav || nav.dataset.shineBound === 'true') return;
    nav.dataset.shineBound = 'true';

    const TOP_THRESHOLD = 80;
    function sync() {
      const scrolled = window.scrollY > TOP_THRESHOLD;
      // Hidden at the very top; eases in and turns solid once scrolled.
      nav!.classList.toggle('nav--visible', scrolled);
      nav!.classList.toggle('nav--solid', scrolled);
    }
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  // Mobile menu toggle. Bound once (the header persists across view
  // transitions); state is reset after each navigation.
  function initNavMenu() {
    const nav = document.querySelector('.nav') as HTMLElement | null;
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    if (!nav || !toggle || nav.dataset.menuBound === 'true') return;
    nav.dataset.menuBound = 'true';

    function setOpen(open: boolean) {
      nav!.classList.toggle('nav--open', open);
      toggle!.setAttribute('aria-expanded', String(open));
      toggle!.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    toggle.addEventListener('click', () => {
      setOpen(!nav.classList.contains('nav--open'));
    });

    // Close on link tap, on Escape, and after each client-side navigation.
    nav.querySelectorAll('.nav__link').forEach((link) =>
      link.addEventListener('click', () => setOpen(false))
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('nav--open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('astro:before-swap', () => setOpen(false));
  }

  document.addEventListener('astro:page-load', () => {
    updateActiveNav();
    initNavShine();
    initNavMenu();
  });
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    /* Top of page: hidden, dark ink (always legible on the light palette). */
    background-color: transparent;
    border-bottom: 1px solid transparent;
    /* Hidden until scrolled: slid up and faded out. */
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
    transition:
      opacity var(--duration-hover) var(--easing),
      transform var(--duration-hover) var(--easing),
      background-color var(--duration-hover) var(--easing),
      border-color var(--duration-hover) var(--easing);
  }

  /* Eased into view once scrolled past the threshold. */
  .nav--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* No-JS: the hide-until-scroll toggle never runs, so keep the nav visible and
     usable as plain links (progressive enhancement). */
  :global(.no-js) .nav {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* Scrolled state: solid blurred background lifts the nav off the content. */
  .nav--solid {
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom-color: var(--color-divider);
  }

  .nav__brand {
    font-family: var(--font-display);
    font-weight: var(--font-weight-bold);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--color-text);
    transition: color var(--duration-hover) var(--easing);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Hamburger toggle: hidden on desktop, shown below the mobile breakpoint. */
  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    margin: -10px -10px -10px 0;
    color: var(--color-text);
  }

  .nav__toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transition:
      transform var(--duration-hover) var(--easing),
      opacity var(--duration-hover) var(--easing);
  }

  /* Animate the bars into an X when the menu is open. */
  .nav--open .nav__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav--open .nav__toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav--open .nav__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav__link {
    position: relative;
    font-size: 0.9rem;
    color: var(--color-muted);
    padding: 0.25rem 0;
    transition: color var(--duration-hover) var(--easing);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-hover) var(--easing);
  }

  .nav__link:hover {
    color: var(--color-text);
  }

  .nav__link.is-active {
    color: var(--color-accent);
    font-weight: var(--font-weight-bold);
  }

  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  @media (min-width: 768px) {
    .nav {
      padding: 1rem 2.5rem;
    }

    .nav__list {
      gap: 2rem;
    }
  }

  /* Mobile: always solid for a clean, legible bar; links collapse behind a
     hamburger toggle that reveals a slide-down panel. */
  @media (max-width: 767px) {
    .nav {
      flex-wrap: wrap;
      background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
      backdrop-filter: blur(10px);
      border-bottom-color: var(--color-divider);
      /* Always visible and tappable on mobile (the hide-until-scroll behavior
         is desktop-only), so the hamburger is reachable at the top of a page. */
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .nav__toggle {
      display: flex;
    }

    .nav__list {
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      /* Collapsed by default; expands when the toggle is activated. */
      display: grid;
      grid-template-rows: 0fr;
      overflow: hidden;
      transition: grid-template-rows var(--duration-hover) var(--easing);
    }

    .nav__list > li {
      min-height: 0;
      width: 100%;
    }

    .nav--open .nav__list {
      grid-template-rows: 1fr;
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: var(--rule-hair) solid var(--color-divider);
    }

    .nav__link {
      display: block;
      padding: 0.75rem 0;
      font-size: 1rem;
    }

    /* No-JS: without the toggle handler, show the links as a plain stacked
       list so navigation always works. */
    :global(.no-js) .nav__list {
      grid-template-rows: 1fr;
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: var(--rule-hair) solid var(--color-divider);
    }

    :global(.no-js) .nav__toggle {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav__brand,
    .nav__link,
    .nav__link::after,
    .nav__toggle-bar,
    .nav__list {
      transition: none;
    }
  }
</style>
