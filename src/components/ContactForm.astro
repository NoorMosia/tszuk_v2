---
/**
 * ContactForm — static-safe, Supabase-gated contact form.
 *
 * Progressive enhancement: a visible mailto:hello@tszuk.com link is always
 * present, so with JS off the form degrades to email. With JS on, submissions
 * route through the env-gated Supabase adapter (or a success + mailto fallback
 * when the adapter is disabled). Per-field validation withholds submission.
 */
---

<form class="contact-form" novalidate>
  <div class="contact-form__field">
    <label for="contact-name" class="contact-form__label">Name</label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      maxlength="100"
      autocomplete="name"
      class="contact-form__input"
      aria-describedby="error-name"
    />
    <p class="contact-form__error" id="error-name" data-error-for="name"></p>
  </div>

  <div class="contact-form__field">
    <label for="contact-email" class="contact-form__label">Email</label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      maxlength="254"
      autocomplete="email"
      class="contact-form__input"
      aria-describedby="error-email"
    />
    <p class="contact-form__error" id="error-email" data-error-for="email"></p>
  </div>

  <fieldset class="contact-form__fieldset">
    <legend class="contact-form__label">Project Type</legend>
    <div class="contact-form__radios">
      <label class="contact-form__radio">
        <input type="radio" name="projectType" value="brand-identity-web" />
        <span>Brand Identity/Web</span>
      </label>
      <label class="contact-form__radio">
        <input type="radio" name="projectType" value="artist-management" />
        <span>Artist Management</span>
      </label>
      <label class="contact-form__radio">
        <input type="radio" name="projectType" value="other" checked />
        <span>Other</span>
      </label>
    </div>
  </fieldset>

  <div class="contact-form__field">
    <label for="contact-message" class="contact-form__label">Message</label>
    <textarea
      id="contact-message"
      name="message"
      required
      maxlength="5000"
      rows="5"
      class="contact-form__input contact-form__textarea"
      aria-describedby="error-message"
    ></textarea>
    <p class="contact-form__error" id="error-message" data-error-for="message"></p>
  </div>

  <button type="submit" class="contact-form__submit">Send Inquiry</button>

  <p class="contact-form__fallback">
    Prefer email? Reach us any time at
    <a href="mailto:hello@tszuk.com">hello@tszuk.com</a>.
  </p>

  <div class="contact-form__status" aria-live="polite"></div>
</form>

<script>
  import { submitContact, isValidEmail } from '../lib/contact';

  function initContactForm() {
    const form = document.querySelector('.contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const status = form.querySelector('.contact-form__status') as HTMLElement;

    function setError(field: string, message: string) {
      const el = form!.querySelector(`[data-error-for="${field}"]`) as HTMLElement | null;
      if (el) el.textContent = message;
    }

    function clearErrors() {
      form!
        .querySelectorAll('.contact-form__error')
        .forEach((el) => (el.textContent = ''));
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();
      status.textContent = '';
      status.className = 'contact-form__status';

      const name = (form.querySelector('[name="name"]') as HTMLInputElement).value.trim();
      const email = (form.querySelector('[name="email"]') as HTMLInputElement).value.trim();
      const message = (
        form.querySelector('[name="message"]') as HTMLTextAreaElement
      ).value.trim();
      const projectType =
        (form.querySelector('[name="projectType"]:checked') as HTMLInputElement)?.value ||
        'other';

      // Per-field validation.
      let valid = true;
      if (!name) {
        setError('name', 'Please enter your name.');
        valid = false;
      }
      if (!email) {
        setError('email', 'Please enter your email.');
        valid = false;
      } else if (!isValidEmail(email)) {
        setError('email', 'Please enter a valid email address.');
        valid = false;
      }
      if (!message) {
        setError('message', 'Please enter a message.');
        valid = false;
      }
      if (!valid) return;

      const submitBtn = form.querySelector('.contact-form__submit') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      try {
        const result = await submitContact({ name, email, message, projectType });

        if (result.status === 'sent') {
          status.textContent = 'Inquiry received. We will be in touch shortly.';
          status.className = 'contact-form__status contact-form__status--success';
          form.reset();
        } else if (result.status === 'fallback') {
          status.innerHTML =
            'Thanks! Please also reach us at <a href="mailto:hello@tszuk.com">hello@tszuk.com</a>.';
          status.className = 'contact-form__status contact-form__status--success';
          form.reset();
        } else {
          // error — retain entered values, offer mailto fallback.
          status.innerHTML =
            'Your message could not be sent. Please email us at <a href="mailto:hello@tszuk.com">hello@tszuk.com</a>.';
          status.className = 'contact-form__status contact-form__status--error';
        }
      } catch {
        status.innerHTML =
          'Your message could not be sent. Please email us at <a href="mailto:hello@tszuk.com">hello@tszuk.com</a>.';
        status.className = 'contact-form__status contact-form__status--error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Inquiry';
      }
    });
  }

  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 500px;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-form__label {
    font-size: 0.85rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .contact-form__input {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-divider);
    padding: 0.75rem 0;
    font-family: var(--font-family);
    font-size: 1rem;
    color: var(--color-text);
    transition: border-color var(--duration-hover) var(--easing);
  }

  .contact-form__input:focus-visible {
    outline: none;
    border-bottom-color: var(--color-accent);
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form__error {
    font-size: 0.8rem;
    color: var(--color-error);
    min-height: 1em;
    margin: 0;
  }

  .contact-form__fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  .contact-form__radios {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .contact-form__radio {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-muted);
    cursor: pointer;
  }

  .contact-form__radio input[type='radio'] {
    accent-color: var(--color-accent);
  }

  .contact-form__submit {
    align-self: flex-start;
    padding: 0.875rem 2rem;
    background-color: var(--color-accent);
    color: var(--color-surface);
    font-weight: var(--font-weight-bold);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition:
      background-color var(--duration-hover) var(--easing),
      transform var(--duration-hover) var(--easing);
  }

  .contact-form__submit:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .contact-form__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .contact-form__fallback {
    font-size: 0.9rem;
    color: var(--color-muted);
    margin: 0;
  }

  .contact-form__fallback a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .contact-form__status {
    font-size: 0.9rem;
    min-height: 1.4em;
  }

  .contact-form__status a {
    color: inherit;
    text-decoration: underline;
  }

  .contact-form__status--success {
    color: var(--color-accent);
  }

  .contact-form__status--error {
    color: var(--color-error);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-form__submit:hover {
      transform: none;
    }
  }
</style>
