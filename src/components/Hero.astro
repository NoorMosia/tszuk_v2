---
/**
 * Hero — brutalist grid opener (warm brutalist x swiss).
 *
 * Big edge-to-edge headline with a label, a supporting line, and a facts
 * column, aligned to the 12-column grid. Replaces the 3D scroll cover; this is
 * plain HTML/CSS with no scroll hijacking, so it works with JS off.
 */
---

<section class="hero bleed grid-12" aria-label="tszuk, a brand that builds">
  <h1 class="hero__title">Brand that <span>builds</span></h1>
  <p class="hero__sub">We build identities that resonate. For companies and personalities.</p>
  <div class="hero__facts">
    <div><span>Founded</span><b>2026</b></div>
    <div><span>Based</span><b>Gqeberha, ZA</b></div>
    <div><span>Clients</span><b>Companies + Personalities</b></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    padding-block: clamp(3rem, 12vh, 9rem);
    border-bottom: var(--rule-heavy) solid var(--color-text);
    align-content: center;
    align-items: start;
  }

  .hero__label {
    grid-column: 1 / 5;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero__title {
    grid-column: 1 / 11;
    font-weight: var(--font-weight-bold);
    font-size: clamp(3rem, 12vw, 9.5rem);
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .hero__title span {
    color: var(--color-accent);
  }

  .hero__sub {
    grid-column: 1 / 6;
    margin-top: 2rem;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .hero__facts {
    grid-column: 9 / 13;
    align-self: end;
    margin-top: 2rem;
    font-size: 0.8rem;
  }

  .hero__facts div {
    display: flex;
    justify-content: space-between;
    border-top: var(--rule-hair) solid var(--color-divider);
    padding: 0.5rem 0;
  }

  .hero__facts b {
    font-weight: var(--font-weight-regular);
    color: var(--color-text);
  }

  .hero__facts span {
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .hero__title,
    .hero__sub,
    .hero__label,
    .hero__facts {
      grid-column: 1 / 13;
    }
  }
</style>
