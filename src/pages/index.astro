---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Cover from '../components/Cover.astro';
import Hero from '../components/Hero.astro';
import WorkSection from '../components/WorkSection.astro';
import Marquee from '../components/Marquee.astro';
import Capabilities from '../components/Capabilities.astro';

const caseStudies = await getCollection('caseStudies');
const businesses = caseStudies.filter((e) => e.data.group === 'business');
const personalities = caseStudies.filter((e) => e.data.group === 'personality');
---

<Layout title="tszuk | a brand that builds">
  <Cover />
  <div class="home">
    <Hero />

    <WorkSection
      heading="Businesses"
      viewAllHref="/work/businesses"
      entries={businesses}
    />
    <WorkSection
      heading="Personalities"
      viewAllHref="/work/personalities"
      entries={personalities}
    />

    <Marquee />
    <Capabilities />

    <a class="about-teaser" href="/about">
      <p class="about-teaser__eyebrow">About tszuk</p>
      <p class="about-teaser__lead">
        A branding studio in Port Elizabeth building identities that resonate —
        for companies and personalities alike.
      </p>
      <span class="about-teaser__cta">Meet the studio <span aria-hidden="true">→</span></span>
    </a>
  </div>
</Layout>

<style>
  .home {
    position: relative;
    z-index: 1;
    background-color: var(--color-bg);
  }

  .about-teaser {
    display: block;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--section-padding-mobile) 1.5rem;
    color: var(--color-text);
    text-align: center;
  }

  .about-teaser__eyebrow {
    font-size: 0.85rem;
    letter-spacing: var(--letter-spacing-subtitle);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .about-teaser__lead {
    font-size: clamp(1.35rem, 3.5vw, 2rem);
    font-weight: var(--font-weight-light);
    line-height: 1.4;
    max-width: var(--manifesto-max-width);
    margin: 0 auto 1.5rem;
  }

  .about-teaser__cta {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--color-accent);
  }

  .about-teaser__cta span {
    display: inline-block;
    transition: transform var(--duration-hover) var(--easing);
  }

  .about-teaser:hover .about-teaser__cta span {
    transform: translateX(4px);
  }

  @media (min-width: 900px) {
    .about-teaser {
      padding: var(--section-padding) 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-teaser__cta span {
      transition: none;
    }
  }
</style>
