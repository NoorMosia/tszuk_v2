---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import StructuredData from '../../components/StructuredData.astro';
import ScopeMarker from '../../components/ScopeMarker.astro';

export const getStaticPaths = (async () => {
  const entries = await getCollection('caseStudies');
  // Exactly one page per entry; slug = entry id.
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const groupLabel = data.group === 'business' ? 'Business' : 'Personality';
const groupHref = data.group === 'business' ? '/work/businesses' : '/work/personalities';
---

<Layout title={`${data.name} | tszuk`} description={data.description} image={data.heroImage.src}>
  <StructuredData scope="case-study" entry={entry} />

  <article class="case">
    <header class="case__hero">
      <a class="case__back" href={groupHref}>
        <span aria-hidden="true">←</span> {groupLabel === 'Business' ? 'Businesses' : 'Personalities'}
      </a>
      <p class="case__eyebrow">{groupLabel}</p>
      <h1 class="case__name">{data.name}</h1>
      <p class="case__description">{data.description}</p>
      <ScopeMarker scope={data.scope} variant="rows" class="case__scope" />
    </header>

    <div class="case__hero-image">
      <Image
        src={data.heroImage}
        alt={data.heroImageAlt}
        width={1400}
        height={900}
        class="case__hero-img"
        loading="eager"
      />
    </div>

    <div class="case__narrative">
      <section class="case__chapter" aria-labelledby="case-challenge">
        <h2 class="case__chapter-title" id="case-challenge">The Challenge</h2>
        <p class="case__chapter-text">{data.story.challenge}</p>
      </section>
      <section class="case__chapter" aria-labelledby="case-approach">
        <h2 class="case__chapter-title" id="case-approach">Our Approach</h2>
        <p class="case__chapter-text">{data.story.approach}</p>
      </section>
      <section class="case__chapter" aria-labelledby="case-outcome">
        <h2 class="case__chapter-title" id="case-outcome">The Outcome</h2>
        <p class="case__chapter-text">{data.story.outcome}</p>
      </section>
    </div>

    {
      data.pullQuote && (
        <blockquote class="case__pullquote">
          <p>{data.pullQuote}</p>
        </blockquote>
      )
    }

    <div class="case__body">
      <Content />
    </div>

    {
      data.gallery && data.gallery.length > 0 && (
        <section class="case__gallery" aria-label="Project gallery">
          {data.gallery.slice(0, 20).map((item) => (
            <Image
              src={item.image}
              alt={item.alt}
              width={1000}
              height={750}
              class="case__gallery-img"
              loading="lazy"
            />
          ))}
        </section>
      )
    }

    {
      data.testimonial && (
        <figure class="case__testimonial">
          <blockquote class="case__testimonial-quote">
            "{data.testimonial.quote}"
          </blockquote>
          <figcaption class="case__testimonial-by">
            {data.testimonial.attribution}
          </figcaption>
        </figure>
      )
    }

    {
      data.liveLink && (
        <div class="case__live">
          <a
            class="case__live-link"
            href={data.liveLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit the live project <span aria-hidden="true">↗</span>
          </a>
        </div>
      )
    }
  </article>
</Layout>

<style>
  .case {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: calc(var(--section-padding-mobile) + 1rem) 1.5rem var(--section-padding-mobile);
    background-color: var(--color-bg);
  }

  .case__hero {
    max-width: var(--manifesto-max-width);
    margin: 0 auto 3rem;
    text-align: center;
  }

  .case__back {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
    transition: color var(--duration-hover) var(--easing);
  }

  .case__back:hover {
    color: var(--color-accent);
  }

  .case__eyebrow {
    font-size: 0.8rem;
    letter-spacing: var(--letter-spacing-subtitle);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .case__name {
    font-size: clamp(2.25rem, 7vw, 4rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .case__description {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: var(--font-weight-light);
    line-height: 1.5;
    color: var(--color-muted);
    margin-bottom: 1.75rem;
  }

  .case__scope {
    text-align: left;
    max-width: 32rem;
    margin: 0 auto;
  }

  .case__hero-image {
    overflow: hidden;
    border-radius: clamp(0px, 0.75vw, 12px);
    margin-bottom: 4rem;
  }

  .case__hero-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 16 / 10;
  }

  .case__narrative {
    max-width: var(--manifesto-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .case__chapter-title {
    font-size: 0.85rem;
    letter-spacing: var(--letter-spacing-subtitle);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .case__chapter-text {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    line-height: 1.6;
    color: var(--color-text);
  }

  .case__pullquote {
    max-width: var(--content-max-width);
    margin: 4.5rem auto;
    padding: 0 1rem;
    text-align: center;
    border: none;
  }

  .case__pullquote p {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: var(--font-weight-light);
    line-height: 1.35;
    color: var(--color-text);
  }

  .case__body {
    max-width: var(--manifesto-max-width);
    margin: 0 auto 4rem;
    font-size: 1.05rem;
    line-height: var(--line-height-body);
    color: var(--color-text);
  }

  .case__body :global(p) {
    margin-bottom: 1.25rem;
  }

  .case__gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 0 auto 4rem;
  }

  .case__gallery-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: clamp(0px, 0.5vw, 8px);
  }

  .case__testimonial {
    max-width: var(--manifesto-max-width);
    margin: 0 auto 4rem;
    padding: 2.5rem;
    background-color: var(--color-sage);
    border-radius: 12px;
    text-align: center;
  }

  .case__testimonial-quote {
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    font-weight: var(--font-weight-light);
    line-height: 1.45;
    margin: 0 0 1.25rem;
  }

  .case__testimonial-by {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .case__live {
    text-align: center;
  }

  .case__live-link {
    display: inline-block;
    padding: 0.875rem 2rem;
    background-color: var(--color-accent);
    color: var(--color-surface);
    font-weight: var(--font-weight-bold);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition:
      background-color var(--duration-hover) var(--easing),
      transform var(--duration-hover) var(--easing);
  }

  .case__live-link:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  @media (min-width: 640px) {
    .case__gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .case {
      padding: calc(var(--section-padding) + 1rem) 2.5rem var(--section-padding);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case__live-link:hover {
      transform: none;
    }
  }
</style>
