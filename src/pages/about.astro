---
import Layout from '../layouts/Layout.astro';
import ProcessSection from '../components/ProcessSection.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="About | tszuk"
  description="tszuk is a branding studio in Port Elizabeth building identities that resonate, for companies and personalities alike."
>
  <div class="about">
    <section class="about__story bleed" aria-labelledby="about-story">
      <p class="about__eyebrow">About tszuk</p>
      <h1 class="about__title" id="about-story">A brand that builds</h1>
      <p class="about__lead measure">
        tszuk is a branding studio in Port Elizabeth, South Africa. We collaborate with
        companies and personalities to build identities that resonate, brands people
        feel, not just recognise.
      </p>
      <p class="about__paragraph measure">
        We started tszuk because so much branding stops at the surface. A nice logo, a
        tidy palette, and not much underneath. We wanted to make brands that carry a
        feeling all the way through, from the first impression to the smallest detail.
      </p>
      <a class="about__founders-link" href="/founders">
        Meet the founders <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="about__vision bleed" aria-labelledby="about-vision">
      <h2 class="about__section-title" id="about-vision">Our Vision</h2>
      <p class="about__vision-lead measure">
        When you create an ecommerce site, you are not just building a tool for people
        to buy. You are creating an experience that should feel like your brand.
      </p>
      <p class="about__paragraph measure">
        That belief runs through everything we make. Every page, every interaction, every
        quiet moment of polish is a chance to make someone feel something. We treat every
        engagement as brand experience, not just delivery.
      </p>
    </section>

    <div class="about__process bleed">
      <ProcessSection />
    </div>

    <div class="about__faq bleed">
      <FaqSection />
    </div>

    <section class="about__contact bleed" aria-labelledby="about-contact">
      <h2 class="about__section-title" id="about-contact">Start a Conversation</h2>
      <p class="about__paragraph measure">
        Leave your email and we will reach out. Tell us about the brand you want to build.
      </p>
      <ContactForm />
    </section>
  </div>
</Layout>

<style>
  .about {
    background-color: var(--color-bg);
    min-height: 100vh;
  }

  .about__story {
    padding-block: calc(var(--section-padding-mobile) + 2rem) var(--section-padding-mobile);
  }

  .about__vision,
  .about__contact {
    padding-block: var(--section-padding-mobile);
  }

  .about__eyebrow {
    font-size: 0.85rem;
    letter-spacing: var(--letter-spacing-subtitle);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .about__title {
    font-size: clamp(2.75rem, 10vw, 6rem);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin-bottom: 1.75rem;
  }

  .about__lead {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    font-weight: var(--font-weight-light);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .about__paragraph {
    font-size: 1.05rem;
    line-height: var(--line-height-body);
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .about__founders-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 2px;
  }

  .about__founders-link span {
    display: inline-block;
    transition: transform var(--duration-hover) var(--easing);
  }

  .about__founders-link:hover span {
    transform: translateX(4px);
  }

  .about__section-title {
    font-size: 0.85rem;
    letter-spacing: var(--letter-spacing-subtitle);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .about__vision-lead {
    font-size: clamp(1.4rem, 4vw, 2rem);
    font-weight: var(--font-weight-light);
    line-height: 1.4;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 900px) {
    .about__story {
      padding-block: calc(var(--section-padding) + 1rem) var(--section-padding);
    }

    .about__vision,
    .about__contact {
      padding-block: var(--section-padding);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about__founders-link span {
      transition: none;
    }
  }
</style>
