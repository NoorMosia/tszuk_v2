---
import { ClientRouter } from 'astro:transitions';
import SmoothScroll from '../components/SmoothScroll.astro';
import Nav from '../components/Nav.astro';
import BrandedLoader from '../components/BrandedLoader.astro';
import StructuredData from '../components/StructuredData.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const siteUrl = Astro.site?.href || Astro.url.origin || 'https://tszuk.co.za';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const {
  title = 'tszuk | a brand that builds',
  description = 'tszuk is a branding studio collaborating with companies and personalities to build identities that resonate.',
  image = '/og-image.png',
} = Astro.props;

const ogImageUrl = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <meta name="description" content={description} />
    <meta name="author" content="tszuk" />
    <meta name="theme-color" content="#EDEAE4" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="tszuk" />
    <meta property="og:locale" content="en_ZA" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@tszuk" />
    <meta name="twitter:creator" content="@tszuk" />

    <!-- Inter (body) + Space Grotesk (display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700&family=Space+Grotesk:wght@700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" href="/favicon/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <title>{title}</title>

    <ClientRouter />
    <StructuredData scope="site" />

    <!-- Remove no-js class immediately -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <SmoothScroll transition:persist="smooth-scroll" />
    <BrandedLoader transition:persist />
    <header class="site-header" transition:persist>
      <Nav />
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal safety net (Req 10.7): if any motion init fails, ensure no
      // scroll-reveal element is ever left hidden. Runs after each navigation.
      function revealSafetyNet() {
        window.setTimeout(() => {
          document
            .querySelectorAll('.scroll-reveal:not(.visible)')
            .forEach((el) => el.classList.add('visible'));
        }, 1200);
      }
      document.addEventListener('astro:page-load', revealSafetyNet);
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 150;
  }

  main {
    position: relative;
    z-index: 1;
  }
</style>

<style is:global>
  @import '../styles/global.css';
</style>
